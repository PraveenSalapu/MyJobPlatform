# ==============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==============================================
# Copy to .env on your production server
# All VITE_* vars are used by frontend (exposed to browser)
# All other vars are backend-only (server secrets)

# ==============================================
# REQUIRED - Core functionality will break without these
# ==============================================

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gemini AI (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=AIza...
GEMINI_API_KEY=AIza...

# ==============================================
# DEPLOYMENT URLS - Required for production
# ==============================================

# Your deployed backend API URL (Heroku, Railway, Render, etc.)
VITE_API_URL=https://your-backend.herokuapp.com

# Your deployed frontend URL (Vercel, Netlify, etc.)
VITE_APP_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# CORS: Add your frontend domain(s) - comma separated
# The backend automatically allows *.vercel.app and chrome extensions
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ==============================================
# OPTIONAL - Enhanced features
# ==============================================

# RapidAPI JSearch for job listings (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# If not set, job search feature will be disabled
VITE_RAPIDAPI_KEY=your-rapidapi-key

# ==============================================
# SERVER CONFIG - Usually set by hosting provider
# ==============================================

NODE_ENV=production
PORT=3001
