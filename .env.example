# Environment Variables
# Copy this file to .env and fill in your values

# ── Gemini AI ──────────────────────────────────────────────────────────────────
# Required for AI features (resume tailoring, ATS scoring, cover letters)
VITE_GEMINI_API_KEY=your-gemini-api-key       # frontend AI calls (optional — backend is primary)
GEMINI_API_KEY=your-gemini-api-key            # backend AI calls (REQUIRED)

# ── Supabase ───────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Get from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret  # REQUIRED — backend uses this to verify auth tokens offline

# ── URLs (REQUIRED in production) ─────────────────────────────────────────────
# Set VITE_API_URL to your deployed backend URL (e.g. https://your-app.herokuapp.com)
VITE_API_URL=http://localhost:3001
# Set APP_URL to your deployed frontend URL (e.g. https://your-app.vercel.app)
APP_URL=http://localhost:5173
# Comma-separated list of additional allowed CORS origins (optional)
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ── Backend Server ─────────────────────────────────────────────────────────────
PORT=3001

# ── RapidAPI (Job Search) ──────────────────────────────────────────────────────
# Optional — job search feature is disabled gracefully if not set
VITE_RAPIDAPI_KEY=your-rapidapi-key
